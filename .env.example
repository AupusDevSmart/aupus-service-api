# === aupus-service-api - exemplo de configuracao ===
# Copie este arquivo para .env e preencha com valores reais do seu ambiente.
# .env nunca deve ser commitado. Em producao ele vive apenas no servidor.

# === Banco de dados ===
# Dev local (Docker postgres:15-alpine na porta 5433):
#   postgresql://postgres:postgres@localhost:5433/aupus_local?schema=public&connection_limit=10&pool_timeout=20
# Producao: ajustar usuario/senha/host conforme servidor.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public&connection_limit=10&pool_timeout=20"

# === Servidor ===
NODE_ENV=development                 # development | production
PORT=3000
LOG_LEVEL=debug                      # debug | info | warn | error

# === CORS ===
# Lista separada por virgula com origens permitidas. Vazio = reflete qualquer origem (uso apenas em dev).
# Producao: CORS_ORIGIN=https://service.aupusenergia.com.br,https://nexon.aupusenergia.com.br
CORS_ORIGIN=

# === Frontend (usado em links de email, redirects, etc.) ===
FRONTEND_URL=http://localhost:5173

# === JWT ===
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE-ME
JWT_EXPIRATION=1h
JWT_REFRESH_EXPIRATION=7d

# === MQTT broker ===
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=root
MQTT_PASSWORD=CHANGE-ME
# production = conecta e SALVA no banco | development = conecta sem salvar | disabled = nao conecta
# IMPORTANTE: apenas UMA instancia pode rodar com MQTT_MODE=production por vez.
MQTT_MODE=disabled
MQTT_LOG_LEVEL=normal                # minimal | normal | verbose
INSTANCE_ID=local-dev

# === Redis (buffer MQTT) ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# === SMTP (emails transacionais) ===
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@example.com
SMTP_PASS=CHANGE-ME
SMTP_FROM_NAME=Aupus
SMTP_FROM_EMAIL=noreply@example.com
# E-mail das notificações (SN-47): só "on" envia. Vazio, os avisos ficam no sino e a fila marca o
# e-mail como "desligado" — no dev os e-mails dos usuários são reais (cópia de produção)
NOTIFICACOES_EMAIL=
# Periodicidade por calendário (SN-54): só "on" faz mensal, bimestral, trimestral, semestral e anual
# vencerem no mesmo dia do mês. Vazio, dias fixos (mensal = 30). Ligar depois de rodar
# scripts/db/comparar-periodicidade.ts e ver a comparação das tarefas reais
PERIODICIDADE_POR_CALENDARIO=

# === Integracoes de servico (Bearer entre os backends; vazio = rota fechada) ===
# Sincronizacao de cadastro com o NexON
SINCRONIZACAO_TOKEN=
# Chamados do NexON viram solicitacao (POST /integracoes/nexon/chamados); no NexON e o SMART_SERVICE_TOKEN
NEXON_CHAMADOS_TOKEN=

# === Sentry (opcional) ===
SENTRY_DSN=

# === Seed do dev (scripts/seed-dev, so aupus_local/aupus_test) ===
# Senha das pessoas do seed (dominio seed.aupus.example). Vazio = senha provisoria aleatoria.
SEED_SENHA=
