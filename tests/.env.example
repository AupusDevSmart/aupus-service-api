# Configuração dos testes e2e do aupus-service-api
# Copie para tests/.env (fora do git) e preencha.

# URL base da API (IMPORTANTE: incluir /api/v1)
API_BASE_URL=http://localhost:3000/api/v1

# Admin que os testes usam para entrar: o do seed do dev, com a senha que você definiu.
# Nunca pôr senha aqui: este arquivo é versionado e o repo é público (SN-9).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Configurações opcionais
TEST_TIMEOUT=10000
